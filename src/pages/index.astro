---
import Layout from '../layouts/Layout.astro';
import { profile, about, skills, projects, experience } from '../data';

const year = new Date().getFullYear();
---

<Layout title={`${profile.name} — Portfolio`} description={profile.intro}>
  <header class="nav wrap">
    <a href="#top" class="logo">{profile.name}</a>
    <nav>
      <a href="#about">Chi sono</a>
      <a href="#projects">Progetti</a>
      <a href="#experience">Esperienza</a>
      <a href="#contact">Contatti</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero wrap">
      <p class="eyebrow">{profile.role} · {profile.location}</p>
      <h1>Ciao, sono {profile.name}.</h1>
      <p class="lead">{profile.intro}</p>
      <div class="actions">
        <a class="btn primary" href="#projects">Guarda i progetti</a>
        <a class="btn" href={`mailto:${profile.email}`}>Scrivimi</a>
      </div>
    </section>

    <section id="about" class="wrap section">
      <h2>Chi sono</h2>
      <div class="cols">
        <div class="prose">{about.map((p) => <p>{p}</p>)}</div>
        <ul class="skills">{skills.map((s) => <li>{s}</li>)}</ul>
      </div>
    </section>

    <section id="projects" class="wrap section">
      <h2>Progetti</h2>
      <div class="grid">
        {
          projects.map((p) => (
            <a class="card" href={p.url} target="_blank" rel="noopener">
              <h3>
                {p.title} <span aria-hidden="true">↗</span>
              </h3>
              <p>{p.description}</p>
              <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
            </a>
          ))
        }
      </div>
    </section>

    <section id="experience" class="wrap section">
      <h2>Esperienza</h2>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li>
              <span class="period">{e.period}</span>
              <div>
                <h3>
                  {e.title} <span class="place">· {e.place}</span>
                </h3>
                <p>{e.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="wrap section contact">
      <h2>Lavoriamo insieme</h2>
      <p class="lead">Hai un progetto o una proposta? Scrivimi, rispondo volentieri.</p>
      <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
      <ul class="links">
        {
          profile.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="wrap footer">© {year} {profile.name}</footer>
</Layout>

<style>
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .logo {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    gap: 22px;
    font-size: 0.95rem;
  }
  .nav nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .nav nav a:hover {
    color: var(--text);
  }

  .hero {
    padding-top: 12vh;
    padding-bottom: 14vh;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
    margin: 0 0 16px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .lead {
    color: var(--muted);
    font-size: 1.2rem;
    max-width: 38ch;
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .btn {
    display: inline-block;
    padding: 12px 22px;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn:hover {
    border-color: var(--text);
  }
  .btn.primary {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .section {
    padding-top: 72px;
    padding-bottom: 72px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 2rem;
    letter-spacing: -0.01em;
    margin: 0 0 32px;
  }
  h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
  }
  .prose p {
    margin: 0 0 16px;
  }
  .skills,
  .tags,
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: start;
  }
  .skills li {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .card h3 span {
    color: var(--accent);
  }
  .card p {
    color: var(--muted);
    margin: 0 0 20px;
    flex: 1;
  }
  .tags li {
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--bg);
    padding: 3px 10px;
    border-radius: 6px;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .timeline li:last-child {
    border-bottom: 0;
  }
  .period {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 2px;
  }
  .place {
    color: var(--muted);
    font-weight: 400;
  }
  .timeline p {
    margin: 0;
    color: var(--muted);
  }

  .contact .mail {
    display: inline-block;
    margin: 28px 0 24px;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    color: var(--accent);
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--text);
  }
  .links li + li::before {
    content: '·';
    margin-right: 8px;
    color: var(--muted);
  }

  .footer {
    padding-top: 32px;
    padding-bottom: 48px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 680px) {
    .wrap {
      padding: 0 16px;
    }
    .nav nav {
      display: none;
    }
    .cols {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
